.reference/
.idea/
.vscode/
.gitignore

# Locally-created pi sessions (from running the `pi` binary against this repo)
.pi/

# Release/publish run logs (stdouts captured during `task publish` etc.)
*-publish.log
task-*.log
release-*.log
.claude/*
target/*

# Benchmark scratch: the npm-installed native pi that scripts/bench-vs-pi.mjs
# compares against (~400 MiB of node_modules).
.bench/

# Static frontend deployment bundle
.deploy/
.codegraph
.shob/*
!.shob/skills/
.shob/skills/*
!.shob/skills/shob-extension-authoring/
!.shob/skills/shob-extension-authoring/SKILL.md
!.shob/skills/shob-release/
!.shob/skills/shob-release/SKILL.md
website/.shob/*
.git/shob-release-helper.exe
publish-*.log
